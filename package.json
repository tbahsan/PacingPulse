{
  "name": "pacingpulse",
  "version": "0.1.0",
  "private": true,
  "description": "PacingPulse — Interactive sentence length & prose cadence visualizer for writers and editors.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "pacing",
    "rhythm",
    "sentence-length",
    "cadence",
    "creative-writing",
    "editing",
    "offline-pwa",
    "typescript"
  ],
  "author": "Tasneem Bin Ahsan",
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.1",
    "happy-dom": "^20.14.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  }
}
